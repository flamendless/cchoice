package components

import (
	"cchoice/cmd/web/components/common"
	"cchoice/cmd/web/models"
	"cchoice/internal/constants"
	"cchoice/internal/enums"
	"cchoice/internal/services"
	"cchoice/internal/utils"
)

type CollectionReceiptPrefill struct {
	InvoiceID      string
	InvoiceNumber  string
	ReceivedFrom   string
	RecipientEmail string
	TIN            string
	Address        string
	ReceiptDate    string
	Amount         string
	PaymentFor     string
	PaymentForm    string
	SCCitizenTIN   string
	OSCAPWDIDNo    string
	Settlements    []services.CollectionReceiptSettlementInput
}

templ CollectionReceiptsCollapsibleSection(canAccess bool) {
	if canAccess {
		<details class="mb-6 border border-gray-200 rounded-lg">
			<summary class="cursor-pointer select-none px-4 py-3 bg-gray-50 rounded-lg font-semibold text-gray-900 hover:bg-gray-100">
				Collection Receipts
			</summary>
			<div class="p-4">
				<p class="text-sm text-gray-500 mb-4">View, preview, and email generated collection receipts.</p>
				<div
					hx-get={ utils.URL("/admin/collection-receipts/table") }
					hx-trigger="load"
					hx-target="#collection-receipts-table-content"
					hx-swap="innerHTML"
				>
					<div id="collection-receipts-table-content"></div>
				</div>
			</div>
		</details>
	}
}

templ AdminCollectionReceiptsTableContent(receipts []services.CollectionReceiptListItem, p models.TablePagination) {
	<div id="collection-receipts-table-content">
		<div id="collection-receipts-pagination-top" hx-swap-oob="true">
			@TablePaginationBar(p)
		</div>
		@AdminCollectionReceiptsTable(receipts)
		@TablePaginationBar(p)
	</div>
}

templ AdminCollectionReceiptsTable(receipts []services.CollectionReceiptListItem) {
	<div class="overflow-x-auto">
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50">
				<tr>
					<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Receipt #</th>
					<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Received From</th>
					<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
					<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
					<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
					<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				if len(receipts) == 0 {
					<tr>
						<td colspan="6" class="px-4 py-4 text-center text-gray-500">No collection receipts yet.</td>
					</tr>
				} else {
					for _, receipt := range receipts {
						<tr>
							<td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-gray-900">{ receipt.ReceiptNumber }</td>
							<td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">{ receipt.ReceivedFrom }</td>
							<td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">{ receipt.ReceiptDate }</td>
							<td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">{ receipt.Amount }</td>
							<td class="px-4 py-3 whitespace-nowrap text-sm">
								<span class="inline-flex px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">{ receipt.Status.String() }</span>
								if receipt.PDFReady {
									<span class="ml-1 inline-flex px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">PDF Ready</span>
								}
								if receipt.Emailed {
									<span class="ml-1 inline-flex px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">Emailed</span>
								}
							</td>
							<td class="px-4 py-3 whitespace-nowrap text-sm">
								<div class="flex items-center gap-2">
									<button
										type="button"
										class="text-primary hover:underline text-xs font-medium"
										hx-get={ utils.URLf("/admin/collection-receipts/%s/preview", receipt.ID) }
										hx-target="#collection-receipt-preview-modal-container"
										hx-swap="innerHTML"
									>
										Preview
									</button>
									if receipt.Emailed {
										<button
											type="button"
											disabled
											class="text-xs font-medium px-3 py-1 rounded bg-gray-200 text-gray-500 cursor-not-allowed"
											title="Already sent via email"
										>
											Send via Email
										</button>
									} else {
										<button
											type="button"
											class="text-white bg-primary hover:bg-primary-dark px-3 py-1 rounded text-xs font-medium"
											data-collection-receipts-table-url={ utils.URL("/admin/collection-receipts/table") }
											hx-post={ utils.URLf("/admin/collection-receipts/%s/email", receipt.ID) }
											hx-confirm="Send this collection receipt to the recipient via email?"
											hx-swap="none"
											hx-on::after-request="if(event.detail.successful){htmx.ajax('GET',event.target.dataset.collectionReceiptsTableUrl,{target:'#collection-receipts-table-content',swap:'innerHTML'})}"
										>
											Send via Email
										</button>
									}
								</div>
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}

templ CollectionReceiptGenerateModal(config services.InvoiceConfig, prefill *CollectionReceiptPrefill) {
	<div
		id="collection-receipt-generate-modal"
		class="fixed inset-0 z-50 flex items-center justify-center"
		data-create-url={ utils.URL("/admin/collection-receipts") }
		data-table-url={ utils.URL("/admin/collection-receipts/table") }
		data-generate-url={ utils.URL("/admin/collection-receipts/generate") }
		data-invoice-search-url={ utils.URL("/admin/invoices/search") }
		data-preview-url-template={ utils.URL("/admin/collection-receipts/%s/preview") }
		data-currency={ orDefault(config.Currency, "PHP") }
		_="on closeModal set #collection-receipt-generate-modal-container.innerHTML to '' end"
	>
		<div class="absolute inset-0 bg-black/50" _="on click trigger closeModal"></div>
		<div class="relative bg-white rounded-lg shadow-xl p-6 w-full max-w-3xl mx-4 overflow-y-auto max-h-[92vh]">
			<div class="flex justify-between items-center mb-4">
				<h2 class="text-xl font-semibold text-gray-900">Create Collection Receipt</h2>
				<button type="button" class="text-gray-400 hover:text-gray-600" _="on click trigger closeModal">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			@invoiceConfigPreview(config)
			<div id="collection-receipt-generate-error" class="hidden mb-3 rounded-md bg-red-50 border border-red-200 text-red-700 text-sm px-3 py-2"></div>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
				<div class="sm:col-span-2">
					<label class="block text-sm font-medium text-gray-700 mb-1">Link to Invoice (optional)</label>
					@AdminEntitySearch(
						"collection-receipt-invoice-search",
						"collection-receipt-invoice-id",
						"Search by invoice number or recipient…",
						collectionReceiptPrefillField(prefill, "invoice_id"),
						collectionReceiptPrefillField(prefill, "invoice_number"),
					)
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Received From <span class="text-red-500">*</span></label>
					<input type="text" id="collection-receipt-received-from" value={ collectionReceiptPrefillField(prefill, "received_from") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
					<input type="email" id="collection-receipt-email" value={ collectionReceiptPrefillField(prefill, "email") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">TIN</label>
					<input type="text" id="collection-receipt-tin" value={ collectionReceiptPrefillField(prefill, "tin") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Receipt Date</label>
					<input type="date" id="collection-receipt-date" value={ collectionReceiptPrefillField(prefill, "receipt_date") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full"/>
				</div>
				<div class="sm:col-span-2">
					<label class="block text-sm font-medium text-gray-700 mb-1">Address</label>
					<input type="text" id="collection-receipt-address" value={ collectionReceiptPrefillField(prefill, "address") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Amount <span class="text-red-500">*</span></label>
					<input type="text" id="collection-receipt-amount" value={ collectionReceiptPrefillField(prefill, "amount") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full" placeholder="0.00"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Payment For</label>
					<input type="text" id="collection-receipt-payment-for" value={ collectionReceiptPrefillField(prefill, "payment_for") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Form of Payment</label>
					<select id="collection-receipt-payment-form" class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full">
						<option value="CASH" if collectionReceiptPaymentFormSelected(prefill, enums.RECEIPT_PAYMENT_CASH) { selected }>Cash</option>
						<option value="CHECK" if collectionReceiptPaymentFormSelected(prefill, enums.RECEIPT_PAYMENT_CHECK) { selected }>Check</option>
					</select>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Sr. Citizen TIN</label>
					<input type="text" id="collection-receipt-sc-tin" value={ collectionReceiptPrefillField(prefill, "sc_tin") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">OSCA/PWD ID No.</label>
					<input type="text" id="collection-receipt-osca-pwd" value={ collectionReceiptPrefillField(prefill, "osca_pwd") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full"/>
				</div>
			</div>
			<div class="mb-3">
				<div class="flex flex-wrap items-end gap-2 mb-2">
					<p class="text-sm font-medium text-gray-700 flex-grow">Settlement Rows</p>
					<button type="button" id="collection-receipt-add-settlement" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300 text-sm">Add Row</button>
				</div>
				<div class="overflow-x-auto border border-gray-200 rounded-md">
					<table class="min-w-full text-sm">
						<thead class="bg-gray-50">
							<tr>
								<th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Invoice No.</th>
								<th class="px-3 py-2 text-right text-xs font-medium text-gray-500 uppercase w-40">Amount</th>
								<th class="px-3 py-2 w-10"></th>
							</tr>
						</thead>
						<tbody id="collection-receipt-settlements">
							if prefill != nil && len(prefill.Settlements) > 0 {
								for _, row := range prefill.Settlements {
									@collectionReceiptSettlementRow(row.InvoiceID, row.InvoiceNumber, row.Amount)
								}
							}
						</tbody>
					</table>
				</div>
			</div>
			<div class="flex flex-wrap gap-2 justify-end pt-4 mt-4 border-t border-gray-200">
				<button type="button" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300 text-sm" _="on click trigger closeModal">Cancel</button>
				<button type="button" data-collection-receipt-action="preview" class="px-4 py-2 bg-gray-700 text-white rounded-md hover:bg-gray-800 text-sm">Preview</button>
				<button type="button" data-collection-receipt-action="save" class="px-4 py-2 bg-primary text-white rounded-md hover:bg-primary-dark text-sm">Save</button>
			</div>
		</div>
	</div>
}

templ collectionReceiptSettlementRow(invoiceID string, invoiceNumber string, amount string) {
	<tr class="collection-receipt-settlement-row border-t border-gray-100" data-invoice-id={ invoiceID }>
		<td class="px-3 py-2">
			<input type="text" class="settlement-invoice px-2 py-1 border border-gray-300 rounded w-full" value={ invoiceNumber } placeholder="Invoice number"/>
		</td>
		<td class="px-3 py-2">
			<input type="text" class="settlement-amount px-2 py-1 border border-gray-300 rounded w-full text-right" value={ amount } placeholder="0.00"/>
		</td>
		<td class="px-3 py-2 text-center">
			<button type="button" class="settlement-remove text-red-600 hover:text-red-800 font-bold">&times;</button>
		</td>
	</tr>
}

templ CollectionReceiptPreviewModal(data services.CollectionReceiptRenderData) {
	@invoiceWideModalShell("collection-receipt-preview-modal", collectionReceiptPreviewTitle(data)) {
		<div class="max-h-[70vh] overflow-y-auto pr-1">
			@CollectionReceiptViewBody(data)
		</div>
		<div class="flex justify-end gap-2 pt-4 mt-4 border-t border-gray-200">
			<a
				href={ utils.URLf("/admin/collection-receipts/%s/pdf", data.Receipt.ID) }
				target="_blank"
				class="px-4 py-2 bg-gray-700 text-white rounded-md hover:bg-gray-800 text-sm"
			>
				Download PDF
			</a>
			<button type="button" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300 text-sm" _="on click trigger closeModal">Close</button>
		</div>
	}
}

templ CollectionReceiptViewBody(data services.CollectionReceiptRenderData) {
	<div class="flex items-start gap-4 mb-4">
		if data.Config.LogoURL != "" {
			<img src={ data.Config.LogoURL } alt="Logo" class="h-16 w-auto object-contain shrink-0"/>
		} else {
			<img src={ constants.PathEmailLogoCDN } alt="C-Choice" class="h-16 w-auto object-contain shrink-0"/>
		}
		<div class="flex-grow text-center">
			<h1 class="text-2xl font-bold text-gray-900">COLLECTION RECEIPT</h1>
			<p class="text-lg font-semibold mt-2">{ data.Config.BusinessName }</p>
			if data.Config.Address != "" {
				<p class="text-sm text-gray-600">{ data.Config.Address }</p>
			}
			if data.Config.TIN != "" {
				<p class="text-xs text-gray-500 mt-1">TIN: { data.Config.TIN }</p>
			}
		</div>
	</div>
	<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4 text-sm md:text-right">
		<div></div>
		<div>
			<p><span class="text-gray-500">Receipt No:</span> <span class="font-semibold">{ data.Receipt.ReceiptNumber }</span></p>
			<p><span class="text-gray-500">Date:</span> { data.Receipt.ReceiptDate }</p>
		</div>
	</div>
	<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6 text-sm">
		<div>
			<p class="text-xs uppercase text-gray-500 font-semibold mb-2">In Settlement of the following:</p>
			<table class="min-w-full text-sm border border-gray-300">
				<thead class="bg-gray-100">
					<tr>
						<th class="border border-gray-300 px-2 py-1 text-left">Invoice No.</th>
						<th class="border border-gray-300 px-2 py-1 text-right">Amount</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range data.Settlements {
						<tr>
							<td class="border border-gray-300 px-2 py-1">{ row.InvoiceNumber }</td>
							<td class="border border-gray-300 px-2 py-1 text-right">{ row.Amount }</td>
						</tr>
					}
				</tbody>
			</table>
			<div class="mt-3 text-xs text-gray-600">
				<p class="font-semibold mb-1">Form of Payment</p>
				if data.Receipt.PaymentForm == enums.RECEIPT_PAYMENT_CASH {
					<p>[X] Cash &nbsp; [ ] Check</p>
				} else {
					<p>[ ] Cash &nbsp; [X] Check</p>
				}
			</div>
		</div>
		<div class="text-sm space-y-2">
			<p>
				Received from <span class="font-semibold">{ data.Receipt.ReceivedFrom }</span>
				if data.Receipt.TIN != "" {
					<span> with TIN { data.Receipt.TIN }</span>
				}
			</p>
			if data.Receipt.Address != "" {
				<p>and address at { data.Receipt.Address }</p>
			}
			<p>{ data.Receipt.AmountInWords }, the sum of</p>
			<p class="font-semibold">(P { data.Receipt.Amount }) in partial/full payment for { orDash(data.Receipt.PaymentFor) }</p>
			<div class="grid grid-cols-1 gap-2 mt-4 text-xs">
				<div class="border border-gray-300 p-2">
					<p class="text-gray-500 font-semibold">Sr. Citizen TIN</p>
					<p>{ orDash(data.Receipt.SCCitizenTIN) }</p>
				</div>
				<div class="border border-gray-300 p-2">
					<p class="text-gray-500 font-semibold">OSCA/PWD ID No.</p>
					<p>{ orDash(data.Receipt.OSCAPWDIDNo) }</p>
				</div>
			</div>
			<p class="text-xs font-semibold text-gray-500 text-center pt-2">THIS DOCUMENT IS NOT VALID FOR CLAIM OF INPUT TAXES.</p>
			<div class="border-t border-gray-400 pt-2 mt-4 text-center text-xs text-gray-500">
				<p class="mb-6">By:</p>
				<p class="border-t border-gray-400 pt-1">Cashier/Authorized Representative</p>
			</div>
		</div>
	</div>
	if data.Config.BIRAuthorityToPrint != "" || data.Config.BIRDateIssued != "" || data.Config.BIRBookletsInfo != "" {
		<div class="text-xs text-gray-500 text-center border-t border-gray-200 pt-3">
			if data.Config.BIRAuthorityToPrint != "" {
				<p>BIR Authority to Print No. { data.Config.BIRAuthorityToPrint }</p>
			}
			if data.Config.BIRDateIssued != "" {
				<p>Date Issued: { data.Config.BIRDateIssued }</p>
			}
			if data.Config.BIRBookletsInfo != "" {
				<p>{ data.Config.BIRBookletsInfo }</p>
			}
		</div>
	}
}

templ ScrCollectionReceiptGenerate() {
	<script type="text/javascript" src={ utils.URL(utils.VersionedAsset("/static/js/admin_entity_search.js")) }></script>
	<script type="text/javascript" src={ utils.URL(utils.VersionedAsset("/static/js/collection_receipt_generate.js")) }></script>
}

templ AdminCollectionReceiptViewPage(data services.CollectionReceiptRenderData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@common.HeadMeta()
			@common.TabTitle(data.Receipt.ReceiptNumber + " - Collection Receipt")
			<style type="text/css">
				@media print {
					.no-print { display: none !important; }
					body { background: white; }
				}
			</style>
		</head>
		<body class="bg-gray-100 min-h-screen">
			<div class="no-print p-4 max-w-4xl mx-auto flex gap-2">
				<a href={ utils.URL("/admin/invoices") } class="text-primary hover:underline text-sm">&larr; Back to Invoices</a>
				<a
					href={ utils.URLf("/admin/collection-receipts/%s/pdf", data.Receipt.ID) }
					target="_blank"
					class="ml-auto px-3 py-1 bg-primary text-white rounded text-sm hover:bg-primary-dark"
				>
					Download PDF
				</a>
			</div>
			<div class="max-w-4xl mx-auto bg-white shadow-md rounded-lg p-8 mb-8">
				@CollectionReceiptViewBody(data)
			</div>
		</body>
	</html>
}

func collectionReceiptPreviewTitle(data services.CollectionReceiptRenderData) string {
	return "Collection Receipt Preview — " + data.Receipt.ReceiptNumber
}

func collectionReceiptPrefillField(prefill *CollectionReceiptPrefill, field string) string {
	if prefill == nil {
		return ""
	}
	switch field {
	case "invoice_id":
		return prefill.InvoiceID
	case "invoice_number":
		return prefill.InvoiceNumber
	case "received_from":
		return prefill.ReceivedFrom
	case "email":
		return prefill.RecipientEmail
	case "tin":
		return prefill.TIN
	case "address":
		return prefill.Address
	case "receipt_date":
		return prefill.ReceiptDate
	case "amount":
		return prefill.Amount
	case "payment_for":
		return prefill.PaymentFor
	case "sc_tin":
		return prefill.SCCitizenTIN
	case "osca_pwd":
		return prefill.OSCAPWDIDNo
	default:
		return ""
	}
}

func collectionReceiptPaymentFormSelected(prefill *CollectionReceiptPrefill, form enums.ReceiptPaymentForm) bool {
	if prefill == nil || prefill.PaymentForm == "" {
		return form == enums.RECEIPT_PAYMENT_CASH
	}
	return prefill.PaymentForm == form.String()
}
