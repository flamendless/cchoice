package components

import (
	"cchoice/cmd/web/components/common"
	"cchoice/cmd/web/models"
	"cchoice/internal/constants"
	"cchoice/internal/services"
	"cchoice/internal/utils"
)

type DeliveryReceiptPrefill struct {
	InvoiceID      string
	InvoiceNumber  string
	DeliveredTo    string
	RecipientEmail string
	TIN            string
	Address        string
	ReceiptDate    string
	Terms          string
	PONumber       string
	Lines          []services.DeliveryReceiptLineInput
}

templ DeliveryReceiptsCollapsibleSection(canAccess bool) {
	if canAccess {
		<details class="mb-6 border border-gray-200 rounded-lg">
			<summary class="cursor-pointer select-none px-4 py-3 bg-gray-50 rounded-lg font-semibold text-gray-900 hover:bg-gray-100">
				Delivery Receipts
			</summary>
			<div class="p-4">
				<p class="text-sm text-gray-500 mb-4">View, preview, and email generated delivery receipts.</p>
				<div
					hx-get={ utils.URL("/admin/delivery-receipts/table") }
					hx-trigger="load"
					hx-target="#delivery-receipts-table-content"
					hx-swap="innerHTML"
				>
					<div id="delivery-receipts-table-content"></div>
				</div>
			</div>
		</details>
	}
}

templ AdminDeliveryReceiptsTableContent(receipts []services.DeliveryReceiptListItem, p models.TablePagination) {
	<div id="delivery-receipts-table-content">
		<div id="delivery-receipts-pagination-top" hx-swap-oob="true">
			@TablePaginationBar(p)
		</div>
		@AdminDeliveryReceiptsTable(receipts)
		@TablePaginationBar(p)
	</div>
}

templ AdminDeliveryReceiptsTable(receipts []services.DeliveryReceiptListItem) {
	<div class="overflow-x-auto">
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50">
				<tr>
					<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Receipt #</th>
					<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Delivered To</th>
					<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
					<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
					<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				if len(receipts) == 0 {
					<tr>
						<td colspan="5" class="px-4 py-4 text-center text-gray-500">No delivery receipts yet.</td>
					</tr>
				} else {
					for _, receipt := range receipts {
						<tr>
							<td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-gray-900">{ receipt.ReceiptNumber }</td>
							<td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">{ receipt.DeliveredTo }</td>
							<td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">{ receipt.ReceiptDate }</td>
							<td class="px-4 py-3 whitespace-nowrap text-sm">
								<span class="inline-flex px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">{ receipt.Status.String() }</span>
								if receipt.PDFReady {
									<span class="ml-1 inline-flex px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">PDF Ready</span>
								}
								if receipt.Emailed {
									<span class="ml-1 inline-flex px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">Emailed</span>
								}
							</td>
							<td class="px-4 py-3 whitespace-nowrap text-sm">
								<div class="flex items-center gap-2">
									<button
										type="button"
										class="text-primary hover:underline text-xs font-medium"
										hx-get={ utils.URLf("/admin/delivery-receipts/%s/preview", receipt.ID) }
										hx-target="#delivery-receipt-preview-modal-container"
										hx-swap="innerHTML"
									>
										Preview
									</button>
									if receipt.Emailed {
										<button
											type="button"
											disabled
											class="text-xs font-medium px-3 py-1 rounded bg-gray-200 text-gray-500 cursor-not-allowed"
											title="Already sent via email"
										>
											Send via Email
										</button>
									} else {
										<button
											type="button"
											class="text-white bg-primary hover:bg-primary-dark px-3 py-1 rounded text-xs font-medium"
											data-delivery-receipts-table-url={ utils.URL("/admin/delivery-receipts/table") }
											hx-post={ utils.URLf("/admin/delivery-receipts/%s/email", receipt.ID) }
											hx-confirm="Send this delivery receipt to the recipient via email?"
											hx-swap="none"
											hx-on::after-request="if(event.detail.successful){htmx.ajax('GET',event.target.dataset.deliveryReceiptsTableUrl,{target:'#delivery-receipts-table-content',swap:'innerHTML'})}"
										>
											Send via Email
										</button>
									}
								</div>
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}

templ DeliveryReceiptGenerateModal(config services.InvoiceConfig, prefill *DeliveryReceiptPrefill) {
	<div
		id="delivery-receipt-generate-modal"
		class="fixed inset-0 z-50 flex items-center justify-center"
		data-create-url={ utils.URL("/admin/delivery-receipts") }
		data-table-url={ utils.URL("/admin/delivery-receipts/table") }
		data-generate-url={ utils.URL("/admin/delivery-receipts/generate") }
		data-invoice-search-url={ utils.URL("/admin/invoices/search") }
		data-preview-url-template={ utils.URL("/admin/delivery-receipts/%s/preview") }
		_="on closeModal set #delivery-receipt-generate-modal-container.innerHTML to '' end"
	>
		<div class="absolute inset-0 bg-black/50" _="on click trigger closeModal"></div>
		<div class="relative bg-white rounded-lg shadow-xl p-6 w-full max-w-3xl mx-4 overflow-y-auto max-h-[92vh]">
			<div class="flex justify-between items-center mb-4">
				<h2 class="text-xl font-semibold text-gray-900">Create Delivery Receipt</h2>
				<button type="button" class="text-gray-400 hover:text-gray-600" _="on click trigger closeModal">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			@invoiceConfigPreview(config)
			<div id="delivery-receipt-generate-error" class="hidden mb-3 rounded-md bg-red-50 border border-red-200 text-red-700 text-sm px-3 py-2"></div>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
				<div class="sm:col-span-2">
					<label class="block text-sm font-medium text-gray-700 mb-1">Link to Invoice (optional)</label>
					@AdminEntitySearch(
						"delivery-receipt-invoice-search",
						"delivery-receipt-invoice-id",
						"Search by invoice number or recipient…",
						deliveryReceiptPrefillField(prefill, "invoice_id"),
						deliveryReceiptPrefillField(prefill, "invoice_number"),
					)
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Delivered To <span class="text-red-500">*</span></label>
					<input type="text" id="delivery-receipt-delivered-to" value={ deliveryReceiptPrefillField(prefill, "delivered_to") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
					<input type="email" id="delivery-receipt-email" value={ deliveryReceiptPrefillField(prefill, "email") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">TIN</label>
					<input type="text" id="delivery-receipt-tin" value={ deliveryReceiptPrefillField(prefill, "tin") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Receipt Date</label>
					<input type="date" id="delivery-receipt-date" value={ deliveryReceiptPrefillField(prefill, "receipt_date") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full"/>
				</div>
				<div class="sm:col-span-2">
					<label class="block text-sm font-medium text-gray-700 mb-1">Address</label>
					<input type="text" id="delivery-receipt-address" value={ deliveryReceiptPrefillField(prefill, "address") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Terms</label>
					<input type="text" id="delivery-receipt-terms" value={ deliveryReceiptPrefillField(prefill, "terms") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full" placeholder="e.g. 30 DAYS"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">P.O. Number</label>
					<input type="text" id="delivery-receipt-po-number" value={ deliveryReceiptPrefillField(prefill, "po_number") } class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary w-full"/>
				</div>
			</div>
			<div class="mb-3">
				<div class="flex flex-wrap items-end gap-2 mb-2">
					<p class="text-sm font-medium text-gray-700 flex-grow">Line Items</p>
					<button type="button" id="delivery-receipt-add-line" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300 text-sm">Add Line</button>
				</div>
				<div class="overflow-x-auto border border-gray-200 rounded-md">
					<table class="min-w-full text-sm">
						<thead class="bg-gray-50">
							<tr>
								<th class="px-3 py-2 text-right text-xs font-medium text-gray-500 uppercase w-20">Qty</th>
								<th class="px-3 py-2 text-right text-xs font-medium text-gray-500 uppercase w-24">Unit</th>
								<th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
								<th class="px-3 py-2 w-10"></th>
							</tr>
						</thead>
						<tbody id="delivery-receipt-lines">
							if prefill != nil && len(prefill.Lines) > 0 {
								for _, line := range prefill.Lines {
									@deliveryReceiptLineRow(line.Quantity, line.Unit, line.Description)
								}
							}
						</tbody>
					</table>
				</div>
			</div>
			<div class="flex flex-wrap gap-2 justify-end pt-4 mt-4 border-t border-gray-200">
				<button type="button" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300 text-sm" _="on click trigger closeModal">Cancel</button>
				<button type="button" data-delivery-receipt-action="preview" class="px-4 py-2 bg-gray-700 text-white rounded-md hover:bg-gray-800 text-sm">Preview</button>
				<button type="button" data-delivery-receipt-action="save" class="px-4 py-2 bg-primary text-white rounded-md hover:bg-primary-dark text-sm">Save</button>
			</div>
		</div>
	</div>
}

templ deliveryReceiptLineRow(qty string, unit string, description string) {
	<tr class="delivery-receipt-line-row border-t border-gray-100">
		<td class="px-3 py-2">
			<input type="text" class="line-qty px-2 py-1 border border-gray-300 rounded w-full text-right" value={ qty } placeholder="1"/>
		</td>
		<td class="px-3 py-2">
			<input type="text" class="line-unit px-2 py-1 border border-gray-300 rounded w-full text-right" value={ unit } placeholder="pc"/>
		</td>
		<td class="px-3 py-2">
			<input type="text" class="line-desc px-2 py-1 border border-gray-300 rounded w-full" value={ description } placeholder="Item description"/>
		</td>
		<td class="px-3 py-2 text-center">
			<button type="button" class="line-remove text-red-600 hover:text-red-800 font-bold">&times;</button>
		</td>
	</tr>
}

templ DeliveryReceiptPreviewModal(data services.DeliveryReceiptRenderData) {
	@invoiceWideModalShell("delivery-receipt-preview-modal", deliveryReceiptPreviewTitle(data)) {
		<div class="max-h-[70vh] overflow-y-auto pr-1">
			@DeliveryReceiptViewBody(data)
		</div>
		<div class="flex justify-end gap-2 pt-4 mt-4 border-t border-gray-200">
			<a
				href={ utils.URLf("/admin/delivery-receipts/%s/pdf", data.Receipt.ID) }
				target="_blank"
				class="px-4 py-2 bg-gray-700 text-white rounded-md hover:bg-gray-800 text-sm"
			>
				Download PDF
			</a>
			<button type="button" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300 text-sm" _="on click trigger closeModal">Close</button>
		</div>
	}
}

templ DeliveryReceiptViewBody(data services.DeliveryReceiptRenderData) {
	<div class="flex items-start gap-4 mb-4">
		if data.Config.LogoURL != "" {
			<img src={ data.Config.LogoURL } alt="Logo" class="h-16 w-auto object-contain shrink-0"/>
		} else {
			<img src={ constants.PathEmailLogoCDN } alt="C-Choice" class="h-16 w-auto object-contain shrink-0"/>
		}
		<div class="flex-grow text-center">
			<h1 class="text-2xl font-bold text-gray-900">DELIVERY RECEIPT</h1>
			<p class="text-lg font-semibold mt-2">{ data.Config.BusinessName }</p>
			if data.Config.Address != "" {
				<p class="text-sm text-gray-600">{ data.Config.Address }</p>
			}
			if data.Config.TIN != "" {
				<p class="text-xs text-gray-500 mt-1">TIN: { data.Config.TIN }</p>
			}
		</div>
	</div>
	<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 text-sm">
		<div>
			<p class="text-xs uppercase text-gray-500 font-semibold mb-1">Delivered To</p>
			<p class="font-semibold">{ data.Receipt.DeliveredTo }</p>
			if data.Receipt.TIN != "" {
				<p class="text-gray-600">TIN: { data.Receipt.TIN }</p>
			}
			if data.Receipt.Address != "" {
				<p class="text-gray-600">{ data.Receipt.Address }</p>
			}
			if data.Receipt.RecipientEmail != "" {
				<p class="text-gray-600">{ data.Receipt.RecipientEmail }</p>
			}
		</div>
		<div class="md:text-right">
			<p><span class="text-gray-500">Receipt No:</span> <span class="font-semibold">{ data.Receipt.ReceiptNumber }</span></p>
			<p><span class="text-gray-500">Date:</span> { data.Receipt.ReceiptDate }</p>
			if data.Receipt.Terms != "" {
				<p><span class="text-gray-500">Terms:</span> { data.Receipt.Terms }</p>
			}
			if data.Receipt.PONumber != "" {
				<p><span class="text-gray-500">P.O. No.:</span> { data.Receipt.PONumber }</p>
			}
			if data.Receipt.InvoiceNumber != "" {
				<p><span class="text-gray-500">Invoice:</span> { data.Receipt.InvoiceNumber }</p>
			}
		</div>
	</div>
	<div class="overflow-x-auto mb-6">
		<table class="min-w-full text-sm border border-gray-300">
			<thead class="bg-gray-100">
				<tr>
					<th class="border border-gray-300 px-2 py-1 text-center">Qty</th>
					<th class="border border-gray-300 px-2 py-1 text-center">Unit</th>
					<th class="border border-gray-300 px-2 py-1 text-left">Articles</th>
				</tr>
			</thead>
			<tbody>
				for _, line := range data.Lines {
					<tr>
						<td class="border border-gray-300 px-2 py-1 text-center">{ line.Quantity }</td>
						<td class="border border-gray-300 px-2 py-1 text-center">{ orDash(line.Unit) }</td>
						<td class="border border-gray-300 px-2 py-1">{ line.Description }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	<p class="text-sm text-gray-600 mb-6">Received the above articles in good order and condition.</p>
	<div class="grid grid-cols-3 gap-4 text-xs text-gray-500 text-center mb-6">
		<div class="border-t border-gray-400 pt-1">Prepared by</div>
		<div class="border-t border-gray-400 pt-1">Delivered by</div>
		<div class="border-t border-gray-400 pt-1">Received by</div>
	</div>
	if data.Config.BIRAuthorityToPrint != "" || data.Config.BIRDateIssued != "" || data.Config.BIRBookletsInfo != "" {
		<div class="text-xs text-gray-500 text-center border-t border-gray-200 pt-3 mb-4">
			if data.Config.BIRAuthorityToPrint != "" {
				<p>BIR Authority to Print No. { data.Config.BIRAuthorityToPrint }</p>
			}
			if data.Config.BIRDateIssued != "" {
				<p>Date Issued: { data.Config.BIRDateIssued }</p>
			}
			if data.Config.BIRBookletsInfo != "" {
				<p>{ data.Config.BIRBookletsInfo }</p>
			}
		</div>
	}
	<p class="text-xs font-semibold text-gray-500 text-center">THIS DOCUMENT IS NOT VALID FOR CLAIM OF INPUT TAX.</p>
	if data.Config.FooterNotes != "" {
		<p class="text-xs text-gray-400 text-center italic mt-2">{ data.Config.FooterNotes }</p>
	}
}

templ ScrDeliveryReceiptGenerate() {
	<script type="text/javascript" src={ utils.URL(utils.VersionedAsset("/static/js/admin_entity_search.js")) }></script>
	<script type="text/javascript" src={ utils.URL(utils.VersionedAsset("/static/js/delivery_receipt_generate.js")) }></script>
}

templ AdminDeliveryReceiptViewPage(data services.DeliveryReceiptRenderData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@common.HeadMeta()
			@common.TabTitle(data.Receipt.ReceiptNumber + " - Delivery Receipt")
			<style type="text/css">
				@media print {
					.no-print { display: none !important; }
					body { background: white; }
				}
			</style>
		</head>
		<body class="bg-gray-100 min-h-screen">
			<div class="no-print p-4 max-w-4xl mx-auto flex gap-2">
				<a href={ utils.URL("/admin/invoices") } class="text-primary hover:underline text-sm">&larr; Back to Invoices</a>
				<a
					href={ utils.URLf("/admin/delivery-receipts/%s/pdf", data.Receipt.ID) }
					target="_blank"
					class="ml-auto px-3 py-1 bg-primary text-white rounded text-sm hover:bg-primary-dark"
				>
					Download PDF
				</a>
			</div>
			<div class="max-w-4xl mx-auto bg-white shadow-md rounded-lg p-8 mb-8">
				@DeliveryReceiptViewBody(data)
			</div>
		</body>
	</html>
}

func deliveryReceiptPreviewTitle(data services.DeliveryReceiptRenderData) string {
	return "Delivery Receipt Preview — " + data.Receipt.ReceiptNumber
}

func deliveryReceiptPrefillField(prefill *DeliveryReceiptPrefill, field string) string {
	if prefill == nil {
		return ""
	}
	switch field {
	case "invoice_id":
		return prefill.InvoiceID
	case "invoice_number":
		return prefill.InvoiceNumber
	case "delivered_to":
		return prefill.DeliveredTo
	case "email":
		return prefill.RecipientEmail
	case "tin":
		return prefill.TIN
	case "address":
		return prefill.Address
	case "receipt_date":
		return prefill.ReceiptDate
	case "terms":
		return prefill.Terms
	case "po_number":
		return prefill.PONumber
	default:
		return ""
	}
}
