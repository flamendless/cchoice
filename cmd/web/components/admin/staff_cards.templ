package components

import (
	"strings"

	"cchoice/cmd/web/models"
	"cchoice/internal/utils"
)

templ AdminStaffCardsGrid(cards []models.StaffCard) {
	<div id="admin-dashboard-cards" class="max-w-4xl mx-auto grid gap-6 grid-cols-[repeat(auto-fill,16rem)]">
		<div class="col-span-full grid grid-cols-subgrid gap-6 items-center max-sm:flex max-sm:flex-col max-sm:gap-3">
			<input
				type="search"
				id="admin-dashboard-search"
				autocomplete="off"
				placeholder="Search admin pages..."
				class="block w-full p-2.5 text-sm text-gray-900 border border-primary rounded-md bg-white focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary max-sm:w-full [grid-column:1/-2]"
			/>
			<form
				action={ utils.URL("/admin/logout") }
				method="POST"
				class="justify-self-end max-sm:w-full max-sm:flex max-sm:justify-end [grid-column:-1]"
			>
				<button
					type="submit"
					onclick="return confirm('Are you sure you want to log out?')"
					class="py-2 px-6 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary"
				>
					Log Out
				</button>
			</form>
		</div>
		for _, card := range cards {
			<a
				href={ utils.URL(card.Link) }
				class="admin-dashboard-card block bg-white rounded-lg shadow-md p-6 text-center hover:shadow-lg hover:scale-105 transition-all duration-200 border-2 border-transparent hover:border-primary"
				data-search-text={ strings.ToLower(card.Title + " " + card.Description) }
			>
				<div class="flex justify-center mb-4">
					@card.Icon
				</div>
				<h2 class="text-xl font-semibold text-gray-800 mb-2">{ card.Title }</h2>
				<p class="text-sm text-gray-500">{ card.Description }</p>
			</a>
		}
	</div>
	<p id="admin-dashboard-no-results" class="hidden text-center text-gray-500 py-8 max-w-4xl mx-auto">
		No pages match your search.
	</p>
}

templ ScriptAdminDashboardSearch() {
	<script defer type="text/javascript" src={ templ.URL(utils.StaticURL("/static/js/admin_dashboard_search.js")) }></script>
}
