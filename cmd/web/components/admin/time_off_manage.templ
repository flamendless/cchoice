package components

import "fmt"
import "strconv"

import "cchoice/cmd/web/models"
import "cchoice/internal/utils"
import "cchoice/cmd/web/components/common"
import "cchoice/cmd/web/components/header"
import "cchoice/internal/enums"

templ AdminTimeOffManagePage(staffList []models.Staff) {
	<!DOCTYPE html>
	<html lang="en" class="overflow-x-hidden">
		<head>
			@common.HeadMeta()
			@common.TabTitle("[ADMIN] Leave Management - C-Choice Admin")
		</head>
		<body
			class="bg-surface min-h-screen flex flex-col"
			_="init call metrics_event('admin_visit', 'time off')"
		>
			@common.ErrorBanner()
			@common.SuccessBanner()
			<div id="time-off-reject-modal-container"></div>
			<div class="flex-grow p-4">
				<div class="max-w-8xl mx-auto">
					<div class="bg-white rounded-lg shadow-md p-6">
						@header.AdminStaffHeaderWithBack()
						<h1 class="text-2xl font-bold text-center text-primary mb-6">
							Leave Management
						</h1>
						<div class="mb-8 p-4 bg-gray-50 rounded-lg">
							<h2 class="text-lg font-semibold text-gray-800 mb-4">Grant Leave Credits (hours)</h2>
							<form class="space-y-4 max-w-xl">
								<div>
									<label for="staff_id" class="block text-sm font-medium text-gray-700 mb-1">Staff</label>
									<select id="staff_id" name="staff_id" required class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary">
										<option value="">-- Select Staff --</option>
										for _, st := range staffList {
											<option value={ st.ID }>{ st.FullName } ({ st.Email })</option>
										}
									</select>
								</div>
								<div>
									<label for="grant-hours" class="block text-sm font-medium text-gray-700 mb-1">Hours</label>
									<input type="number" id="grant-hours" name="hours" required min="0.5" step="0.5" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" placeholder="e.g. 8"/>
								</div>
								<div>
									<label for="grant-note" class="block text-sm font-medium text-gray-700 mb-1">Note (optional)</label>
									<input type="text" id="grant-note" name="note" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" placeholder="e.g. Annual allocation"/>
								</div>
								<button
									type="button"
									class={ getButtonClass(true) }
									hx-post={ utils.URL("/admin/time-off/credits") }
									hx-trigger="click"
									hx-swap="none"
								>
									Grant Credits
								</button>
							</form>
						</div>
						<div
							class="bg-white rounded-lg shadow-md p-6"
							hx-get={ utils.URL("/admin/time-off/table") }
							hx-trigger="load"
							hx-target="#time-off-table"
							hx-swap="innerHTML"
						>
							<div id="time-off-table">
								<p class="text-gray-500 text-center py-4">Loading...</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</body>
	</html>
}

templ AdminTimeOffManageTable(timeOffs []models.StaffTimeOff) {
	<div class="overflow-x-auto">
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50">
				<tr>
					@TableHead("Staff Name")
					@TableHead("Type")
					@TableHead("Hours")
					@TableHead("Filed Date")
					@TableHead("Start Date")
					@TableHead("End Date")
					@TableHead("Reason")
					@TableHead("Status")
					@TableHead("Reject Reason")
					@TableHead("Reviewed By")
					@TableHead("Reviewed At")
					@TableHead("Actions")
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				for _, to := range timeOffs {
					<tr id={ fmt.Sprintf("time-off-row-%s", to.ID) } class={ timeOffStatusRowClass(to.Status) }>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
							{ to.FullName }
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm">
							{ to.Type.ToHuman() }
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
							{ strconv.FormatFloat(to.Hours, 'f', -1, 64) }
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
							{ to.CreatedAt }
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
							{ to.StartDate }
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
							{ to.EndDate }
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
							{ to.Description }
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm">
							<span class={ timeOffStatusTextClass(to.Status) }>
								{ to.Status.ToHuman() }
							</span>
						</td>
						<td class="px-6 py-4 text-sm text-gray-900 max-w-xs truncate">
							{ to.RejectReason }
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
							{ to.ApprovedBy }
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
							{ to.ApprovedAt }
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
							if to.Status == enums.TIME_OFF_STATUS_PENDING {
								<button
									class="text-white bg-green-600 hover:bg-green-700 px-3 py-1 rounded text-xs font-medium"
									hx-patch={ utils.URL(fmt.Sprintf("/admin/time-off/%s/approve", to.ID)) }
									hx-confirm="Approve this leave request?"
								>
									Approve
								</button>
								<button
									class="text-white bg-red-600 hover:bg-red-700 px-3 py-1 rounded text-xs font-medium"
									hx-get={ utils.URL(fmt.Sprintf("/admin/time-off/%s/reject-modal", to.ID)) }
									hx-target="#time-off-reject-modal-container"
									hx-swap="innerHTML"
								>
									Reject
								</button>
							} else if to.Status == enums.TIME_OFF_STATUS_APPROVED {
								<button
									class="text-white bg-gray-600 hover:bg-gray-700 px-3 py-1 rounded text-xs font-medium"
									hx-patch={ utils.URL(fmt.Sprintf("/admin/time-off/%s/cancel", to.ID)) }
									hx-confirm="Revert approval and return hours to balance?"
								>
									Revert
								</button>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ TimeOffRejectModal(timeOffID string) {
	<div id="time-off-reject-modal" class="fixed inset-0 z-50 flex items-center justify-center" _="on closeTimeOffRejectModal set #time-off-reject-modal-container.innerHTML to ''">
		<div class="absolute inset-0 bg-black/50" _="on click trigger closeTimeOffRejectModal"></div>
		<div class="relative bg-white rounded-lg shadow-xl p-6 w-full max-w-md mx-4">
			<div class="flex justify-between items-center mb-4">
				<h2 class="text-xl font-semibold text-gray-900">Reject Leave Request</h2>
				<button type="button" class="text-gray-400 hover:text-gray-600" _="on click trigger closeTimeOffRejectModal">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			<form
				hx-post={ utils.URL(fmt.Sprintf("/admin/time-off/%s/reject", timeOffID)) }
				hx-swap="none"
				class="flex flex-col gap-4"
				hx-on::after-request="if(event.detail.successful) { document.getElementById('time-off-reject-modal-container').innerHTML = '' }"
			>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Reason for rejection <span class="text-red-500">*</span></label>
					<textarea name="reject_reason" required rows="4" placeholder="Please explain why this leave is rejected..." class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary"></textarea>
				</div>
				<div class="flex w-full gap-2 justify-end">
					<button type="button" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300 text-sm" _="on click trigger closeTimeOffRejectModal">Cancel</button>
					<button type="submit" class="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 text-sm">Submit Rejection</button>
				</div>
			</form>
		</div>
	</div>
}

func timeOffStatusRowClass(status enums.TimeOffStatus) string {
	switch status {
	case enums.TIME_OFF_STATUS_APPROVED:
		return "bg-green-50"
	case enums.TIME_OFF_STATUS_REJECTED:
		return "bg-red-50"
	default:
		return "bg-yellow-50"
	}
}

func timeOffStatusTextClass(status enums.TimeOffStatus) string {
	switch status {
	case enums.TIME_OFF_STATUS_APPROVED:
		return "text-green-600 font-medium"
	case enums.TIME_OFF_STATUS_REJECTED:
		return "text-red-600 font-medium"
	default:
		return "text-yellow-700 font-medium"
	}
}
