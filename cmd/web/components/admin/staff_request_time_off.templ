package components

import "strconv"

import "cchoice/cmd/web/components/common"
import "cchoice/cmd/web/components/header"
import "cchoice/internal/utils"
import "cchoice/cmd/web/models"
import "time"
import "cchoice/internal/constants"

templ AdminStaffRequestTimeOffPage(leaveBalance float64) {
	<!DOCTYPE html>
	<html lang="en" class="overflow-x-hidden">
		<head>
			@common.HeadMeta()
			@common.TabTitle("[STAFF] C-Choice Admin")
		</head>
		<body
			class="bg-surface min-h-screen flex flex-col"
			_="init call metrics_event('admin_visit', 'request time off')"
		>
			@common.DevRibbon()
			@common.ErrorBanner()
			@common.SuccessBanner()
			<div class="flex-grow p-4">
				<div class="max-w-4xl mx-auto">
					<div class="bg-white rounded-lg shadow-md p-6">
						@header.AdminStaffHeaderWithBackLink(utils.URL("/admin/staff"), "Back to Home")
						<div class="mb-6 p-4 bg-gray-50 rounded-lg">
							<h2 class="text-lg font-semibold text-gray-800 mb-2">Request Leave</h2>
							<p class="text-sm text-gray-600 mb-4">
								Available leave credits: <span class="font-semibold text-primary">{ strconv.FormatFloat(leaveBalance, 'f', -1, 64) } hours</span>
							</p>
							@RequestTimeOffForm()
						</div>
						<div
							class="mb-6 p-4 bg-gray-50 rounded-lg"
							hx-get={ utils.URL("/admin/staff/time-off/table") }
							hx-trigger="load"
							hx-target="#time-off-table"
						>
							<h2 class="text-lg font-semibold text-gray-800 mb-2">My Leave Requests</h2>
							<div id="time-off-table">
								<p class="text-gray-500 text-center py-4">Loading...</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</body>
	</html>
}

templ RequestTimeOffForm() {
	<form class="space-y-4">
		<div>
			<label for="type" class="block text-sm font-medium text-gray-700 mb-1">Type</label>
			<select id="type" name="type" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary">
				<option value="">-- Select Type --</option>
				<option value="VL">Vacation Leave</option>
				<option value="SL">Sick Leave</option>
				<option value="ABSENT">Absent</option>
			</select>
		</div>
		<div class="flex flex-row gap-4 flex-wrap">
			<div>
				<label for="start-date" class="block text-sm font-medium text-gray-700 mb-1">Start Date</label>
				@common.DateSelectorEx("start-date", time.Now().Format(constants.DateLayoutISO), true)
			</div>
			<div>
				<label for="end-date" class="block text-sm font-medium text-gray-700 mb-1">End Date</label>
				@common.DateSelectorEx("end-date", time.Now().Format(constants.DateLayoutISO), true)
			</div>
			<div>
				<label for="hours" class="block text-sm font-medium text-gray-700 mb-1">Hours</label>
				<input type="number" id="hours" name="hours" required min="0.5" step="0.5" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" placeholder="e.g. 8"/>
			</div>
		</div>
		<div>
			<label for="description" class="block text-sm font-medium text-gray-700 mb-1">Reason</label>
			<input type="text" id="description" name="description" required class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" placeholder="Enter reason"/>
		</div>
		<button
			type="button"
			class={ getButtonClass(true) }
			hx-post={ utils.URL("/admin/staff/time-off") }
			hx-trigger="click"
			hx-swap="none"
			_="on click call metrics_event('admin_exec', 'submit time off')"
		>
			Submit
		</button>
	</form>
}

templ StaffTimeOffsTable(timeOffs []models.StaffTimeOff) {
	if len(timeOffs) == 0 {
		<p class="text-gray-500 text-center py-4">No time off requests yet</p>
	} else {
		<div class="overflow-x-auto">
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50">
					<tr>
						@TableHead("Type")
						@TableHead("Hours")
						@TableHead("Filed Date")
						@TableHead("Start Date")
						@TableHead("End Date")
						@TableHead("Reason")
						@TableHead("Status")
						@TableHead("Reject Reason")
						@TableHead("Reviewed By")
						@TableHead("Reviewed At")
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-gray-200">
					for _, to := range timeOffs {
						<tr class={ timeOffStatusRowClass(to.Status) }>
							<td class="px-6 py-4 whitespace-nowrap text-sm">
								{ to.Type.ToHuman() }
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm">
								{ strconv.FormatFloat(to.Hours, 'f', -1, 64) }
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm">
								{ to.CreatedAt }
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm">
								{ to.StartDate }
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm">
								{ to.EndDate }
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm">
								{ to.Description }
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm">
								<span class={ timeOffStatusTextClass(to.Status) }>
									{ to.Status.ToHuman() }
								</span>
							</td>
							<td class="px-6 py-4 text-sm max-w-xs truncate">
								{ to.RejectReason }
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm">
								{ to.ApprovedBy }
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm">
								{ to.ApprovedAt }
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
