package shop

import "fmt"
import "cchoice/cmd/web/models"
import "cchoice/internal/utils"
import "cchoice/cmd/web/components/common"
import "cchoice/internal/constants"

const clsBrandLogo = "w-3xs h-24 object-contain m-auto mt-8"

templ PostHomeContentSections(data models.HomePageData) {
	<div
		id="others"
		class="relative flex flex-col w-full max-w-full px-4 lg:px-8 pt-4 pb-16 border-t-4 border-primary-dark bg-white"
	>
		for _, section := range data.Sections {
			<span class="font-bold text-lg mt-4">{ section.Title }</span>
			switch section.Href {
				case "about-us", "services":
					@CommonSection(section)
				case "store":
					@StoreSection(section)
				case "partners":
					@PartnerSection(section)
			}
		}
	</div>
}

templ CommonSection(section models.PostHomeContentSection) {
	<section
		id={ section.Href }
		class="flex flex-col lg:flex-row justify-between my-6 w-full max-w-full px-4"
	>
		for _, content := range section.Others {
			<div
				class="w-full lg:w-1/4 border-t-4 border-primary-dark"
			>
				<div class="my-2 text-center font-medium text-base">
					{ content.Title }
				</div>
				<div class="my-2 font-normal text-sm text-wrap">
					{ content.Description }
				</div>
			</div>
		}
	</section>
}

templ GMapsAndWaze(gmaps string, waze string) {
	<div class="flex flex-row items-center">
		@common.GMapsLink(gmaps)
		@common.WazeLink(waze)
	</div>
}

templ StoreSection(section models.PostHomeContentSection) {
	<section
		id={ section.Href }
		class="flex flex-col lg:flex-row justify-between my-6 w-full max-w-full px-4"
	>
		<div class="flex flex-col content-center w-full max-w-full">
			<div class="flex flex-col items-center w-full max-w-full">
				<div class="relative overflow-hidden mx-auto max-w-lg w-full">
					// The carousel sits well below the fold, so every slide is lazy.
					// Eagerly loading all seven cost ~600KiB on the initial page load.
					<div id="storeTrack" class="flex transition-transform duration-500 ease-in-out">
						for i, imgURL := range constants.GetStoreImages() {
							<div class="min-w-full">
								<img
									src={ utils.CDNImageWidth(imgURL, constants.WidthStorePhotoDefault) }
									if srcset := utils.CDNImageSrcSet(imgURL, constants.WidthsStorePhoto...); srcset != "" {
										srcset={ srcset }
										sizes={ constants.SizesStorePhoto }
									}
									class="w-full h-[300px] sm:h-[380px] md:h-[430px] lg:h-[460px] object-contain"
									alt={ fmt.Sprintf("Store photo %d", i+1) }
									width={ constants.StoreImageWidth }
									height={ constants.StoreImageHeight }
									loading="lazy"
									decoding="async"
								/>
							</div>
						}
					</div>
				</div>
			</div>
			<div id="storeDots" class="flex justify-center items-center w-full gap-2 mt-2 py-2">
				for i := range constants.GetStoreImages() {
					if i == 0 {
						<span class="w-3 h-3 rounded-full cursor-pointer bg-primary-emphasis"></span>
					} else {
						<span class="w-3 h-3 rounded-full cursor-pointer bg-primary-muted"></span>
					}
				}
			</div>
			<script>
				(function() {
					let cur = 0;
					let timer = null;
					const track = document.getElementById('storeTrack');
					const dots = document.querySelectorAll('#storeDots span');
					const total = dots.length;
					function goTo(n) {
						cur = n;
						track.style.transform = 'translateX(-' + (cur * 100) + '%)';
						dots.forEach(function(d, i) {
							d.classList.remove('bg-primary-emphasis', 'bg-primary-muted');
							d.classList.add(i === cur ? 'bg-primary-emphasis' : 'bg-primary-muted');
						});
					}
					dots.forEach(function(d, i) {
						d.addEventListener('click', function() { goTo(i); });
					});
					// Only advance while the carousel is on screen, so an
					// off-screen section costs neither main-thread work nor the
					// bandwidth of loading slides nobody is looking at.
					function start() {
						if (timer === null) {
							timer = setInterval(function() { goTo((cur + 1) % total); }, 5000);
						}
					}
					function stop() {
						if (timer !== null) {
							clearInterval(timer);
							timer = null;
						}
					}
					if (typeof IntersectionObserver === 'function') {
						new IntersectionObserver(function(entries) {
							entries[0].isIntersecting ? start() : stop();
						}).observe(track);
					} else {
						start();
					}
				})();
			</script>
			<div
				hx-trigger="load once"
				hx-get={ utils.URL("/settings/store") }
				hx-swap="innerHTML"
				hx-target="this"
				class="my-4 font-normal text-base text-center flex flex-col items-center"
			>
				//GMapsAndWaze
				Fetching...
			</div>
		</div>
		for _, content := range section.Others {
			<div
				class="w-full lg:w-1/4 border-t-4 border-primary-dark"
			>
				<div class="my-2 text-center font-medium text-base">
					{ content.Title }
				</div>
				<div class="my-2 font-normal text-sm text-wrap">
					{ content.Description }
				</div>
			</div>
		}
	</section>
}

templ PartnerSection(section models.PostHomeContentSection) {
	<section
		id={ section.Href }
		class="flex flex-wrap my-6 w-full max-w-full pr-4 justify-center items-center"
	>
		for _, content := range section.Others {
			<div
				class="px-2 my-auto basis-1/2 lg:basis-1/6 flex-shrink-0"
			>
				// Brand logos have wildly different intrinsic ratios, so they are
				// drawn into a fixed box with object-contain to keep the row from
				// reflowing as each one decodes.
				<div class="relative inline-block">
					if !content.BrandImage.IsComingSoon {
						<img
							src={ utils.CDNImageWidth(content.BrandImage.CDNURL, constants.WidthBrandLogoDefault) }
							if srcset := utils.CDNImageSrcSet(content.BrandImage.CDNURL, constants.WidthsBrandLogo...); srcset != "" {
								srcset={ srcset }
								sizes={ constants.SizesBrandLogo }
							}
							hx-trigger="load once"
							hx-swap="none"
							class={ clsBrandLogo }
							alt={ content.BrandImage.Alt }
							loading="lazy"
							decoding="async"
							width={ constants.BrandLogoWidth }
							height={ constants.BrandLogoHeight }
						/>
					} else {
						<img
							src={ utils.CDNImageWidth(content.BrandImage.CDNURL, constants.WidthBrandLogoDefault) }
							if srcset := utils.CDNImageSrcSet(content.BrandImage.CDNURL, constants.WidthsBrandLogo...); srcset != "" {
								srcset={ srcset }
								sizes={ constants.SizesBrandLogo }
							}
							hx-trigger="load once"
							hx-swap="none"
							class={ clsBrandLogo, "opacity-80" }
							alt={ content.BrandImage.Alt }
							loading="lazy"
							decoding="async"
							width={ constants.BrandLogoWidth }
							height={ constants.BrandLogoHeight }
						/>
						<div
							class="
								absolute w-full bottom-0
								mb-1 bg-black/50
								text-white text-xs font-semibold tracking-wide
								py-1 text-center
							"
						>
							Coming Soon Here
						</div>
					}
				</div>
			</div>
		}
	</section>
}
