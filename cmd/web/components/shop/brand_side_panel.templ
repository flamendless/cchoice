package shop

import "cchoice/cmd/web/models"
import "cchoice/internal/utils"
import "cchoice/cmd/web/components/svg"

templ BrandsSidePanelList(selectedBrandLabel string, brands []models.BrandSidePanelText) {
	<div
		id="brands-side-panel-list"
		class="flex flex-col overflow-y-auto scrollbar-hide"
	>
		for _, brand := range brands {
			<a
				id={ "brand-link-" + brand.BrandID }
				href={ templ.SafeURL(brand.URL) }
				class={
					templ.KV("text-xs font-light ml-2 my-0.5 py-0.5 cursor-pointer hover:underline hover:bg-surface transition-colors brand-filter-link", true),
					templ.KV("underline bg-primary font-semibold text-white", selectedBrandLabel != "" && brand.Label == selectedBrandLabel),
				}
				data-brand-name={ brand.Label }
				data-brand-id={ brand.BrandID }
				data-brand-slug={ brand.Slug }
				_="on click call metrics_event('brand_side_panel_select', my @data-brand-slug)"
			>
				<p class="text-ellipsis text-nowrap overflow-hidden">
					{ brand.Label }
				</p>
			</a>
		}
		<p
			class="
				text-ellipsis text-nowrap overflow-hidden
				text-xs font-light ml-2 my-0.5 py-0.5
			"
		>
			<a href={ utils.URL("/brands/") } class="hover:underline hover:text-primary">View all brands</a>
		</p>
		<!-- <script type="text/javascript" src={ templ.URL(utils.URL("/static/js/brand_side_panel.js")) }></script> -->
	</div>
}

templ BrandsSidePanel(selectedBrandLabel string, lazy bool) {
	<div
		id="brands-side-panel"
		class="
			w-full flex flex-col
			border-b-2 border-primary-dark
		"
	>
		<div
			class="flex items-center justify-between cursor-pointer p-2"
			_="on click
				async call metrics_event('brands_side_panel_click')
				toggle .hidden on #brands-side-panel-content
				if #brands-side-panel-content matches .hidden
					set #brands-chevron's *transform to 'rotate(0deg)'
					set #brands-side-panel-content@data-collapsed to 'true'
				else
					set #brands-chevron's *transform to 'rotate(180deg)'
					set #brands-side-panel-content@data-collapsed to 'false'
				end
			"
		>
			<p class="text-xs font-normal text-nowrap">
				Brands
			</p>
			@svg.Chevron("brands-chevron")
		</div>
		<div
			id="brands-side-panel-content"
			hx-trigger={ func() string {
				if lazy {
					return "intersect once, history:restore"
				}
				return "load once, history:restore"
			}() }
			hx-get={ brandSidePanelListURL(selectedBrandLabel) }
			hx-select="#brands-side-panel-list"
			hx-target="find #brands-side-panel-list"
			hx-swap="outerHTML"
			class="pb-[8px]"
		>
			@BrandsSidePanelList(resolveSidePanelHighlight(selectedBrandLabel), nil)
		</div>
	</div>
}
