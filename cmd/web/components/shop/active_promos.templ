package shop

import (
	"cchoice/cmd/web/models"
	"cchoice/internal/constants"
	"cchoice/internal/enums"
	"cchoice/internal/utils"
)

var promoBannerStyleOnce = templ.NewOnceHandle()

templ ActivePromosSection(promos []models.PromoItem) {
	@promoBannerStyle()
	<div class="w-full px-4 py-6">
		<div class="flex flex-col lg:flex-row gap-4">
			for i, promo := range promos {
				@PromoBannerCard(promo, i == 0)
			}
		</div>
	</div>
}

templ PromoBannerCard(promo models.PromoItem, isFirst bool) {
	if promo.Type == enums.PROMO_TYPE_BANNER_IMAGE && promo.Href != "" {
		<a
			href={ templ.SafeURL(promo.Href) }
			if utils.IsExternalURL(promo.Href) {
				target="_blank"
				rel="noopener noreferrer"
			}
			class="flex flex-col justify-center w-full lg:w-1/2 overflow-hidden rounded-lg shadow-md bg-surface cursor-pointer hover:opacity-95 transition"
		>
			@PromoBannerMedia(promo, isFirst)
			@PromoBannerText(promo)
		</a>
	} else {
		<div class="flex flex-col justify-center w-full lg:w-1/2 overflow-hidden rounded-lg shadow-md bg-surface">
			@PromoBannerMedia(promo, isFirst)
			@PromoBannerText(promo)
		</div>
	}
}

// promoBannerStyle reserves the banner's box up front. Uploaded banners have no
// stored dimensions, so without a fixed ratio the surrounding page reflows once
// each image decodes.
templ promoBannerStyle() {
	@promoBannerStyleOnce.Once() {
		<style>
			.promo-banner-media {
				aspect-ratio: 2 / 1;
				width: 100%;
				height: auto;
				object-fit: cover;
			}
		</style>
	}
}

templ PromoBannerMedia(promo models.PromoItem, isFirst bool) {
	switch promo.Type {
		case enums.PROMO_TYPE_BANNER_VIDEO:
			if utils.IsYouTubeURL(promo.MediaURL) {
				<iframe
					class="w-full aspect-video"
					src={ templ.URL(utils.ConvertYouTubeToEmbed(promo.MediaURL)) }
					title={ promo.Title }
					frameborder="0"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
					allowfullscreen
				></iframe>
			} else {
				<video
					class="promo-banner-media"
					src={ promo.MediaURL }
					autoplay
					loop
					muted
					playsinline
				></video>
			}
		case enums.PROMO_TYPE_BANNER_IMAGE:
			<img
				class="promo-banner-media"
				src={ utils.CDNImageWidth(promo.MediaURL, constants.WidthPromoBannerDefault) }
				if srcset := utils.CDNImageSrcSet(promo.MediaURL, constants.WidthsPromoBanner...); srcset != "" {
					srcset={ srcset }
					sizes={ constants.SizesPromoBanner }
				}
				alt={ promo.Title }
				decoding="async"
				if isFirst {
					loading="eager"
					fetchpriority="high"
				} else {
					loading="lazy"
				}
			/>
	}
}

templ PromoBannerText(promo models.PromoItem) {
	<div class="p-4">
		if !promo.BannerOnly {
			<h3 class="text-lg font-semibold text-primary">{ promo.Title }</h3>
			<p class="mt-1 text-sm text-gray-600">{ promo.Description }</p>
		}
	</div>
}
